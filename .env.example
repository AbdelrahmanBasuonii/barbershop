NODE_ENV=production
PORT=3000
APP_URL=https://your-app-domain.example
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# SMTP settings for password reset emails (Resend example)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_replace-with-your-resend-api-key
SMTP_FROM=Barbershop <noreply@your-verified-domain.example>

NODE_ENV=production
PORT=3000
APP_URL=https://your-app-domain.example
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Supabase: use the pooler connection URL for PostgreSQL and the service-role key for private server use only.
DATABASE_URL=postgresql://postgres.your-project:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Resend HTTP API (outbound HTTPS works on Render Free; SMTP is blocked there).
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Barbershop <noreply@your-verified-domain.example>
